# ── Live stream source ────────────────────────────────────────────────────────
RTSP_HOST=live.corp8.cloud
INGEST_API=http://live.corp8.cloud/api/ingest

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=sentinelpass
SECRET_KEY=sentinel-change-in-production
CORS_ORIGINS=http://localhost:3000

# ── Ingestion tuning ──────────────────────────────────────────────────────────
FRAME_FPS=3
JPEG_QUALITY=70
MAX_CONCURRENT_CAMERAS=30
CATALOGUE_SYNC_INTERVAL=300

# ── AI engine ─────────────────────────────────────────────────────────────────
YOLO_MODEL=yolov8n.pt
DETECTION_CONF=0.4
FRAME_SKIP=3
YOLO_WORKERS=4
ANPR_ENABLED=true
FACE_ENABLED=true
BEHAVIOR_ENABLED=true

# ── Intelligence ──────────────────────────────────────────────────────────────
FACE_SIM_THRESHOLD=0.65
PLATE_MATCH_THRESHOLD=0.9
ALERT_COOLDOWN=60
CROSS_CAM_WINDOW=300
