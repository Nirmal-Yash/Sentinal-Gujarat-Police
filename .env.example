# Runtime/auth
ENVIRONMENT=development
AUTH_REQUIRED=true
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_HOURS=8
JWT_TOKEN_HOURS=8
JWT_REFRESH_SECRET_KEY=replace-with-different-long-random-refresh-secret
AUTH_COOKIE_NAME=sentinel_session
AUTH_REFRESH_COOKIE_NAME=sentinel_refresh
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
MAX_SESSIONS_PER_USER=3
LOCKOUT_USER_THRESHOLD=5
LOCKOUT_IP_THRESHOLD=20
LOCKOUT_WINDOW_MINUTES=15
LOCKOUT_DURATION_MINUTES=30
ALLOWED_ORIGINS=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
TEST_ENDPOINT_ENABLED=true

# Current CCTV infrastructure
CCTV_BASE_URL=https://cctv.corp8.cloud
CCTV_LOGIN_PATH=/auth/login
CCTV_CATALOGUE_PATH=/cameras.json
CCTV_EMAIL=replace-with-assigned-feed-email
CCTV_PASSWORD=replace-with-assigned-feed-password
RTSP_HOST_IP=103.250.160.189
RTSP_PORT=8554

# Database/security
POSTGRES_PASSWORD=replace-with-strong-database-password
DATABASE_URL=postgresql://sentinel:<password>@postgres:5432/sentinel
DATABASE_MIGRATION_URL=postgresql://sentinel_migration:<password>@postgres:5432/sentinel
SECRET_KEY=replace-with-long-random-access-secret
SNAPSHOT_TOKEN_SECRET=replace-with-long-random-snapshot-secret
FIELD_ENCRYPTION_KEY=generate-with-Fernet
REDIS_PASSWORD=replace-with-strong-redis-password
DB_SSL=0
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=10000
SNAPSHOT_TOKEN_TTL_SECS=120
EVIDENCE_TOKEN_TTL_SECS=300
EVIDENCE_STORAGE_PATH=/evidence
ALLOWED_EXTERNAL_HOSTS=cctv.corp8.cloud,stream.corp8.cloud,103.250.160.189
FORCE_SECURITY_HEADERS=false

# Local bootstrap
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-bootstrap-password
BOOTSTRAP_ADMIN_ROLE=SUPERADMIN

# Test mode
TEST_FRAME_FPS=3
TEST_FACE_ENABLED=false
TEST_BEHAVIOR_ENABLED=true
TEST_ANPR_OCR_GPU=false
TEST_MAX_UPLOAD_BYTES=209715200
TEST_YOLO_WORKERS=1
ANPR_TEST_VOTE_THRESHOLD=3
ANPR_TEST_VOTE_WINDOW_SECS=8
ANPR_TEST_TRACK_MIN_AGE_SECS=1.5
ANPR_TEST_OCR_WORKERS=2
ANPR_TEST_MAX_PENDING_JOBS=20

# Ingestion
SOURCE_MAX_FPS=15
FRAME_FPS=3
PROCESSING_FPS_HIGHWAY=3.33
PROCESSING_FPS_PEDESTRIAN=2
PROCESSING_FPS_STATIC=1.25
FRAME_GATE_ENABLED=true
FRAME_GATE_MOTION_THRESHOLD=4.0
FRAME_GATE_IDLE_SECS=10
FRAME_GATE_THUMBNAIL_SIZE=160
CAMERA_ALIVE_KEY=camera_alive
CAMERA_ALIVE_INTERVAL_SECS=1
RAW_FRAME_STREAM_MAXLEN=500
JPEG_QUALITY=70
MAX_CONCURRENT_CAMERAS=50
CATALOGUE_SYNC_INTERVAL=300
RECONNECT_MAX_DELAY=30

# AI
YOLO_MODEL=yolov8n.pt
DETECTION_CONF=0.4
FRAME_SKIP=3
TEST_FRAME_SKIP=2
YOLO_WORKERS=4
ANPR_ENABLED=true
ANPR_OCR_GPU=false
ANPR_OCR_INTERVAL_SECS=0.8
ANPR_OCR_MIN_CONF=0.35
ANPR_VOTE_THRESHOLD=4
ANPR_VOTE_WINDOW_SECS=8
ANPR_TRACK_MIN_AGE_SECS=1.5
ANPR_TRACK_EXPIRY_SECS=3
ANPR_OCR_WORKERS=4
ANPR_MAX_PENDING_JOBS=20
ANPR_MIN_VEHICLE_W=80
ANPR_MIN_VEHICLE_H=60
ANPR_MIN_PLATE_WIDTH=45
ANPR_MIN_PLATE_HEIGHT=15
ANPR_MAX_CONCURRENT_TRACKS=128
FACE_ENABLED=true
BEHAVIOR_ENABLED=true

# Intelligence
FACE_SIM_THRESHOLD=0.65
FACE_INVESTIGATION_THRESHOLD=0.65
PLATE_MATCH_THRESHOLD=0.9
WATCHLIST_RELOAD_SECS=60
WATCHLIST_UPDATE_CHANNEL=watchlist:updated
ALERT_COOLDOWN=60
ALERT_DEDUP_PREFIX=sentinel:alert:dedup:
CROSS_CAM_WINDOW=300
MAX_EVIDENCE_BYTES=4194304
