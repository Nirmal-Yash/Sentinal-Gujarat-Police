# ── Runtime / authentication ─────────────────────────────────────────────────
AUTH_REQUIRED=true
JWT_TOKEN_HOURS=8
CORS_ORIGINS=http://localhost:3000
TEST_ENDPOINT_ENABLED=true

# ── Live stream source ────────────────────────────────────────────────────────
RTSP_HOST=live.corp8.cloud
PLAYBACK_HOST=live.corp8.cloud
INGEST_API=http://live.corp8.cloud/api/ingest

# ── Database / security ──────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me
SECRET_KEY=change-me

# Optional operator assistant; set in the VS Code terminal or .env, never commit the secret.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Local/demo only: these provision the first administrator when no active admin exists.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me
BOOTSTRAP_ADMIN_ROLE=SUPERADMIN

# ── Test mode ────────────────────────────────────────────────────────────────
TEST_FRAME_FPS=3
TEST_FACE_ENABLED=false
TEST_BEHAVIOR_ENABLED=true
TEST_ANPR_OCR_GPU=false
TEST_MAX_UPLOAD_BYTES=2147483648
TEST_YOLO_WORKERS=1

# ── Ingestion tuning ──────────────────────────────────────────────────────────
FRAME_FPS=3
JPEG_QUALITY=70
MAX_CONCURRENT_CAMERAS=50
CATALOGUE_SYNC_INTERVAL=300
RECONNECT_MAX_DELAY=30

# ── AI engine ─────────────────────────────────────────────────────────────────
YOLO_MODEL=yolov8n.pt
DETECTION_CONF=0.4
FRAME_SKIP=3
TEST_FRAME_SKIP=2
YOLO_WORKERS=4
ANPR_ENABLED=true
ANPR_OCR_GPU=false
ANPR_OCR_INTERVAL_SECS=0.8
ANPR_OCR_MIN_CONF=0.35
ANPR_CONFIRM_OBSERVATIONS=2
ANPR_TRACK_EXPIRY_SECS=30
ANPR_MIN_VEHICLE_W=80
ANPR_MIN_VEHICLE_H=60
ANPR_MIN_PLATE_WIDTH=45
ANPR_MIN_PLATE_HEIGHT=15
ANPR_MAX_CONCURRENT_TRACKS=128
FACE_ENABLED=true
BEHAVIOR_ENABLED=true

# ── Intelligence ──────────────────────────────────────────────────────────────
FACE_SIM_THRESHOLD=0.65
PLATE_MATCH_THRESHOLD=0.9
ALERT_COOLDOWN=60
CROSS_CAM_WINDOW=300
MAX_EVIDENCE_BYTES=4194304
